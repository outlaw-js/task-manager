generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum BoardRole {
  OWNER
  ADMIN
  MEMBER
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  color        String        @default("#6366f1")
  /// Storage key of the profile photo under UPLOAD_DIR, if any.
  avatar       String?
  createdAt    DateTime      @default(now())
  memberships  BoardMember[]
  ownedBoards  Board[]       @relation("BoardOwner")
  createdTasks Task[]        @relation("TaskCreator")
  assigned     Task[]        @relation("TaskAssignees")
  pushSubscriptions PushSubscription[]
  attachments  Attachment[]
  comments     Comment[]
}

model Board {
  id          String        @id @default(cuid())
  name        String
  description String?
  ownerId     String
  owner       User          @relation("BoardOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  members     BoardMember[]
  columns     Column[]
  labels      Label[]
  tasks       Task[]
}

model BoardMember {
  boardId  String
  userId   String
  role     BoardRole @default(MEMBER)
  joinedAt DateTime  @default(now())
  board    Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([boardId, userId])
}

model Column {
  id       String @id @default(cuid())
  title    String
  color    String @default("#94a3b8")
  position Int
  boardId  String
  board    Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks    Task[]

  @@index([boardId, position])
}

model Label {
  id      String @id @default(cuid())
  name    String
  color   String
  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@unique([boardId, name])
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  priority    Priority  @default(MEDIUM)
  deadline    DateTime?
  position    Int
  boardId     String
  columnId    String
  creatorId   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  board       Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  column      Column    @relation(fields: [columnId], references: [id], onDelete: Cascade)
  creator     User?     @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  assignees   User[]    @relation("TaskAssignees")
  labels      Label[]
  attachments Attachment[]
  comments    Comment[]

  @@index([columnId, position])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A file attached to a task (images, shown on the card) or to one of its comments
/// (`commentId` set; images or documents). The file lives on disk under UPLOAD_DIR at `storageKey`.
model Attachment {
  id         String   @id @default(cuid())
  taskId     String
  commentId  String?
  uploaderId String?
  name       String
  mimeType   String
  size       Int
  storageKey String   @unique
  createdAt  DateTime @default(now())
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  comment    Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  uploader   User?    @relation(fields: [uploaderId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([commentId])
}

/// A message in a task's discussion, visible to the task's creator and assignees.
model Comment {
  id          String       @id @default(cuid())
  taskId      String
  authorId    String?
  body        String
  createdAt   DateTime     @default(now())
  editedAt    DateTime?
  task        Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author      User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  attachments Attachment[]

  @@index([taskId, createdAt])
}
