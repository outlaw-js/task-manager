DATABASE_URL="postgresql://taskmanager:taskmanager@localhost:5435/taskmanager?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"

# Web Push notifications — generate per environment with: npm run push:keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# System-wide admins (comma separated emails): can rename any user and delete any task
SUPER_ADMIN_EMAILS="admin@example.com"

# Where task images are stored (default: ./uploads next to the app; keep it outside deploy cleanups)
# UPLOAD_DIR="/var/lib/taskmanager/uploads"
